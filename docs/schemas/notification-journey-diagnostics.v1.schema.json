{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cronflow.dev/schemas/notification-journey-diagnostics/v1",
  "title": "WOML Notification Journey Diagnostics v1",
  "description": "Secret-safe failed-destination diagnostics derived by Rust from the durable notification projection for CLI presentation.",
  "x-forbiddenFields": [
    "decisionCapability",
    "botToken",
    "appToken",
    "authorization",
    "providerPayload"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "deliveryFailures"],
  "properties": {
    "version": { "const": 1 },
    "deliveryFailures": {
      "type": "array",
      "items": { "$ref": "#/$defs/deliveryFailure" }
    }
  },
  "$defs": {
    "deliveryFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveryId",
        "provider",
        "destination",
        "attempt",
        "final",
        "failure"
      ],
      "properties": {
        "deliveryId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*:notify:(0|[1-9][0-9]*):channel:(0|[1-9][0-9]*)$"
        },
        "provider": { "const": "slack" },
        "destination": {
          "type": "string",
          "pattern": "^(#[a-z0-9][a-z0-9_-]{0,79}|[CG][A-Z0-9]{8,31})$"
        },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "final": { "type": "boolean" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": {
          "enum": [
            "secret_not_found",
            "provider_auth_failed",
            "destination_invalid",
            "rate_limited",
            "provider_unavailable",
            "delivery_ambiguous",
            "request_invalid",
            "host_crashed",
            "size_limit_exceeded",
            "update_failed"
          ]
        },
        "code": { "type": "string", "pattern": "^WOML_[A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "retryable": { "type": "boolean" },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    }
  }
}
