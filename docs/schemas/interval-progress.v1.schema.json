{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cronflow.dev/schemas/interval-progress/v1",
  "title": "WOML Interval Progress v1",
  "description": "Safe operational diagnostics emitted by the durable Rust interval runtime.",
  "oneOf": [
    { "$ref": "#/$defs/nextDue" },
    { "$ref": "#/$defs/schedulerError" }
  ],
  "$defs": {
    "nextDue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "contractVersion", "type", "workflowId", "triggerId",
        "everyMs", "anchorAt", "nextSequence", "nextScheduledAt", "reason",
        "occurredAt"
      ],
      "properties": {
        "contract": { "const": "woml.interval-progress" },
        "contractVersion": { "const": 1 },
        "type": { "const": "next_due" },
        "workflowId": { "type": "string", "minLength": 1 },
        "triggerId": { "type": "string", "minLength": 1 },
        "everyMs": { "type": "integer", "minimum": 1000, "maximum": 2592000000 },
        "anchorAt": { "type": "string", "format": "date-time" },
        "nextSequence": { "type": "integer", "minimum": 1 },
        "nextScheduledAt": { "type": "string", "format": "date-time" },
        "reason": {
          "enum": [
            "initialized", "restarted", "advanced", "misfire_skipped",
            "misfire_run_once"
          ]
        },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "schedulerError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "contractVersion", "type", "workflowId", "triggerId",
        "code", "message", "occurredAt"
      ],
      "properties": {
        "contract": { "const": "woml.interval-progress" },
        "contractVersion": { "const": 1 },
        "type": { "const": "scheduler_error" },
        "workflowId": { "type": "string", "minLength": 1 },
        "triggerId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "pattern": "^WOML_[A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
