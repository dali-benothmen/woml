{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/target-registry/v1",
  "title": "WOML Target Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "version", "targets"],
  "properties": {
    "profile": { "const": "woml.target-registry/v1" },
    "version": { "const": 1 },
    "targets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "allowedWorkerIdentities", "requiredCapabilities", "minimumWorkerVersion", "maximumInFlight"],
        "properties": {
          "id": { "$ref": "#/$defs/targetId" },
          "kind": { "const": "worker-pool" },
          "allowedWorkerIdentities": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
          "requiredCapabilities": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
          "minimumWorkerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$", "maxLength": 64 },
          "maximumInFlight": { "type": "integer", "minimum": 1, "maximum": 64 }
        }
      }
    }
  },
  "$defs": {
    "targetId": { "type": "string", "pattern": "^(?!local$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "identity": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128 }
  }
}
