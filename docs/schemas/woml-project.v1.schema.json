{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/woml-project.v1.schema.json",
  "title": "WOML Project v1",
  "description": "A reference-only assembly contract for WOML workflows and operator-owned configuration.",
  "x-status": "combined-developer-experience-cdx0-frozen",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "version", "name", "workflows"],
  "properties": {
    "$schema": { "const": "https://woml.dev/schemas/woml-project.v1.schema.json" },
    "profile": { "const": "woml.project/v1" },
    "version": { "const": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "runtime": { "$ref": "#/$defs/jsonReference" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processPolicy": { "$ref": "#/$defs/jsonReference" },
        "artifactPolicy": { "$ref": "#/$defs/jsonReference" },
        "infrastructurePolicy": { "$ref": "#/$defs/jsonReference" },
        "policyTrust": { "$ref": "#/$defs/jsonReference" },
        "emergencyDeny": { "$ref": "#/$defs/jsonReference" },
        "reviewerDirectory": { "$ref": "#/$defs/jsonReference" }
      },
      "dependentRequired": {
        "infrastructurePolicy": ["policyTrust"],
        "policyTrust": ["infrastructurePolicy"],
        "emergencyDeny": ["infrastructurePolicy", "policyTrust"]
      }
    },
    "remoteExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRegistry", "targetTrust"],
      "properties": {
        "targetRegistry": { "$ref": "#/$defs/jsonReference" },
        "targetTrust": { "$ref": "#/$defs/jsonReference" }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "jsonReference": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        { "pattern": "\\.json$" }
      ]
    }
  }
}
