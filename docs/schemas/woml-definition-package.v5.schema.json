{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/woml-definition-package.v5.schema.json",
  "title": "WOML Call-Only Runtime Definition Package v5",
  "description": "Runtime promotion of Definition Package v4 without changing Model v10 or module artifacts.",
  "x-status": "workflow-calls-wc0-frozen",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "executable", "runtimeReady", "compilationRootHash", "workflow", "modules", "sources", "artifacts", "compiler", "permissions", "rootHash"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "profile": { "const": "woml.definition-package/v5" },
    "executable": { "const": true },
    "runtimeReady": { "const": true },
    "compilationRootHash": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/sha256" },
    "workflow": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/workflow" },
    "modules": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/modules" },
    "sources": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/sources" },
    "artifacts": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/artifacts" },
    "compiler": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/compiler" },
    "permissions": { "$ref": "https://woml.dev/schemas/woml-definition-package.v1.schema.json#/$defs/permissions" },
    "rootHash": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/sha256" }
  }
}
