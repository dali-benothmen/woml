{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/woml-definition-package.v8.schema.json",
  "title": "WOML Fork and Branch Definition Package v8",
  "description": "Immutable compilation package carrying reviewed Model v13 fork contracts before runtime enablement.",
  "x-status": "fork-branch-fj8-published",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "executable", "runtimeReady", "workflow", "modules", "sources", "artifacts", "compiler", "permissions", "rootHash"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "profile": { "const": "woml.definition-package/v8" },
    "executable": { "const": true },
    "runtimeReady": { "const": false },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["id", "source", "modelDigest", "model"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "source": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/portablePath" },
        "modelDigest": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/sha256" },
        "model": { "$ref": "https://cronflow.dev/schemas/compiled-workflow-model/v13" }
      }
    },
    "modules": { "type": "array", "maxItems": 64, "items": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/module" } },
    "sources": { "type": "array", "minItems": 1, "maxItems": 513, "items": { "$ref": "https://woml.dev/schemas/woml-definition-package.v1.schema.json#/$defs/source" } },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 194, "items": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/artifact" } },
    "compiler": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/compiler" },
    "permissions": { "$ref": "https://woml.dev/schemas/woml-definition-package.v1.schema.json#/$defs/permissions" },
    "rootHash": { "$ref": "https://woml.dev/schemas/woml-definition-package.v4.schema.json#/$defs/sha256" }
  }
}
