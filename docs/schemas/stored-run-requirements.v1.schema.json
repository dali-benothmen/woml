{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/stored-run-requirements.v1.schema.json",
  "title": "WOML Stored Run Requirements v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "workflowId",
    "definitionHash",
    "requiredSecrets",
    "moduleCount",
    "hasApproval",
    "hasNotifications"
  ],
  "properties": {
    "contract": { "const": "woml.stored-run-requirements" },
    "version": { "const": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "definitionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requiredSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "moduleCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "hasApproval": { "type": "boolean" },
    "hasNotifications": { "type": "boolean" }
  }
}
