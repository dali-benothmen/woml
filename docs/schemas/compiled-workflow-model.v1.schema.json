{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cronflow.dev/schemas/compiled-workflow-model/v1",
  "title": "Cronflow Compiled Workflow Model v1",
  "description": "Versioned contract between workflow frontends and the language-neutral Rust execution core. The WOML CLI vertical-slice subset is frozen; fields used only by staged features remain provisional until their listed open questions are closed. The model is a DAG from version 1; an executor may initially choose to execute ready nodes sequentially.",
  "x-status": "vertical-slice-subset-frozen",
  "x-frozenProfile": {
    "name": "woml-cli-vertical-slice",
    "fixture": "woml/tests/fixtures/hello.compiled.v1.json",
    "constraint": "The exact model shapes exercised by the fixture are frozen for implementation. Staged branching, retry, capability, and durable-control shapes are not approved by this status."
  },
  "x-invariants": [
    "The graph must be directed and acyclic.",
    "Node IDs and edge IDs must each be unique within the workflow.",
    "Every edge endpoint must reference a node in the same graph.",
    "Every entryNodeId must reference a node with no incoming edges.",
    "Every node must be reachable from at least one entry node.",
    "A node becomes ready only after all incoming edges have resolved and at least one incoming edge is active. Entry nodes are ready when the run starts.",
    "Multiple ready nodes represent parallelism in the model even when a v1 executor processes them one at a time.",
    "The core must not depend on WOML, XML, template-source syntax, embedded-JavaScript syntax, RAK, or editor concerns.",
    "Resolved secret values must not appear in this artifact.",
    "A definition hash is SHA-256 over the RFC 8785 JSON Canonicalization Scheme encoding of this complete semantic model, formatted as sha256:<lowercase hexadecimal>, and stored outside the bytes being hashed. Compiler provenance is not part of the semantic hash."
  ],
  "x-openQuestions": [
    {
      "id": "context-run-schema",
      "question": "What is the stable public schema of context.run?",
      "constraint": "context.run is unavailable to WOML v0.1 scripts. Do not infer public fields from internal run metadata; a future language version must define and freeze the schema before exposing it."
    },
    {
      "id": "secret-resolution",
      "question": "Which non-persisted surface resolves secret references at execution time?",
      "constraint": "Resolved secret values never enter the compiled model, run event log, or derived context."
    },
    {
      "id": "engine-control-surface",
      "question": "Where do cancel, pause, and durable cross-run state operations live?",
      "constraint": "They are neither context data nor automatically external services."
    },
    {
      "id": "idempotency-contract",
      "question": "How is a handler idempotency key derived, and what must a handler return when the key was already executed?",
      "constraint": "Do not assume either (run_id, node_id) or (run_id, node_id, attempt) until reviewed."
    },
    {
      "id": "condition-language",
      "question": "Is the small condition AST in this draft sufficient for compiled branching, or should conditions compile into dedicated decision nodes?",
      "constraint": "The graph must support branching without embedding WOML or arbitrary JavaScript in the core."
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "triggers",
    "graph"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Compiled workflow model schema version."
    },
    "workflowId": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "metadata": {
      "$ref": "#/$defs/workflowMetadata"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compiledTrigger"
      }
    },
    "graph": {
      "$ref": "#/$defs/workflowGraph"
    }
  },
  "$defs": {
    "nonEmptyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workflowMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "User-defined workflow version. This is not the WOML language or compiled-model schema version."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "compiledTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handler",
        "config"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "handler": {
          "$ref": "#/$defs/handlerId"
        },
        "config": {
          "$ref": "#/$defs/valueExpression"
        }
      }
    },
    "workflowGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryNodeIds",
        "nodes",
        "edges"
      ],
      "properties": {
        "entryNodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyId"
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflowEdge"
          }
        }
      }
    },
    "workflowNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handler",
        "inputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "handler": {
          "$ref": "#/$defs/handlerId"
        },
        "inputs": {
          "$ref": "#/$defs/valueExpression"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "retryPolicy": {
          "$ref": "#/$defs/retryPolicy"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Language-neutral descriptive metadata. It must not contain executable callbacks, source-language ASTs, capabilities, or resolved secrets."
        }
      }
    },
    "workflowEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "from": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "to": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "condition": {
          "$ref": "#/$defs/edgeCondition"
        },
        "branchId": {
          "$ref": "#/$defs/nonEmptyId",
          "description": "Optional stable branch identity used when the frontend models an explicit branch. Runtime branch executions receive separate execution IDs in events."
        }
      }
    },
    "handlerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable registry or descriptor key such as trigger.manual, runtime.script, or a future namespaced capability operation."
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "backoff"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Total attempts including the initial attempt."
        },
        "backoff": {
          "$ref": "#/$defs/backoffPolicy"
        }
      }
    },
    "backoffPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "delayMs"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "initialDelayMs",
            "multiplier"
          ],
          "properties": {
            "kind": {
              "const": "exponential"
            },
            "initialDelayMs": {
              "type": "integer",
              "minimum": 0
            },
            "multiplier": {
              "type": "number",
              "exclusiveMinimum": 1
            },
            "maximumDelayMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "edgeCondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "always"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "truthy"
            },
            "value": {
              "$ref": "#/$defs/valueExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "equals"
            },
            "left": {
              "$ref": "#/$defs/valueExpression"
            },
            "right": {
              "$ref": "#/$defs/valueExpression"
            }
          }
        }
      ]
    },
    "valueExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/literalExpression"
        },
        {
          "$ref": "#/$defs/contextReferenceExpression"
        },
        {
          "$ref": "#/$defs/objectExpression"
        },
        {
          "$ref": "#/$defs/arrayExpression"
        },
        {
          "$ref": "#/$defs/templateExpression"
        }
      ]
    },
    "literalExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {
          "description": "Any JSON value."
        }
      }
    },
    "contextReferenceExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "contextReference"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "objectExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fields"
      ],
      "properties": {
        "kind": {
          "const": "object"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueExpression"
          }
        }
      }
    },
    "arrayExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "array"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueExpression"
          }
        }
      }
    },
    "templateExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "parts"
      ],
      "properties": {
        "kind": {
          "const": "template"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "$ref": "#/$defs/contextReferenceExpression"
              }
            ]
          }
        }
      }
    }
  }
}
