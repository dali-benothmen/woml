{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/deployment-activation/v1",
  "title": "WOML Deployment Activation v1",
  "x-status": "production-runtime-pro0-frozen",
  "description": "Internal atomic identity for direct .woml activation; not a public package format.",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "deploymentId", "activationId", "configurationDigest", "workflows", "requiredSecrets", "state"],
  "properties": {
    "profile": { "const": "woml.deployment-activation/v1" },
    "deploymentId": { "$ref": "#/$defs/id" },
    "activationId": { "$ref": "#/$defs/digest" },
    "configurationDigest": { "$ref": "#/$defs/digest" },
    "state": { "enum": ["preflight", "registered", "ready", "failed", "draining", "stopped"] },
    "workflows": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workflowId", "definitionHash", "moduleArtifacts"],
        "properties": {
          "workflowId": { "$ref": "#/$defs/id" },
          "definitionHash": { "$ref": "#/$defs/digest" },
          "moduleArtifacts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true }
        }
      }
    },
    "requiredSecrets": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128 } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 320 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
