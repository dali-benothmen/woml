{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cronflow.dev/schemas/run-event/v13",
  "title": "WOML Reusable Definition Run Event v13",
  "description": "Event v12 plus bounded reusable invocation lifecycle facts and warnings.",
  "x-status": "switch-custom-definitions-scp0-frozen",
  "x-previousVersion": "https://cronflow.dev/schemas/run-event/v12",
  "x-invariants": [
    "Ordinary custom-step attempts remain ordinary step attempt events.",
    "Provider delivery remains ordinary notification delivery events.",
    "Lifecycle events never contain props, context, results, messages, URLs, secret names, or secret values.",
    "Hook failure is a warning and never replaces the already committed reusable operation outcome."
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["eventSchemaVersion", "eventId", "runId", "sequence", "occurredAt", "type", "data"],
  "properties": {
    "eventSchemaVersion": { "const": 13 },
    "eventId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 }, "occurredAt": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "run_admitted", "run_execution_started", "run_timeout_reached", "step_attempt_started", "step_attempt_succeeded", "step_attempt_failed", "step_retry_scheduled", "branch_selected", "choice_selected", "parallel_group_started", "parallel_group_completed", "approval_requested", "notification_delivery_requested", "notification_delivery_attempt_started", "notification_delivery_succeeded", "notification_delivery_failed", "notification_decision_accepted", "notification_message_update_requested", "notification_message_update_attempt_started", "notification_message_updated", "notification_message_update_failed", "approval_resolved", "operation_started", "operation_succeeded", "operation_failed", "fork_opened", "fork_branch_settled", "fork_join_settled", "run_cancellation_requested", "lifecycle_hook_requested", "lifecycle_action_attempt_started", "lifecycle_action_succeeded", "lifecycle_action_failed", "lifecycle_hook_completed", "reusable_lifecycle_requested", "reusable_lifecycle_action_started", "reusable_lifecycle_action_succeeded", "reusable_lifecycle_action_failed", "reusable_lifecycle_completed", "run_outcome_decided", "run_finalized"
      ]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["reusable_lifecycle_requested", "reusable_lifecycle_action_started", "reusable_lifecycle_action_succeeded", "reusable_lifecycle_action_failed", "reusable_lifecycle_completed"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/reusableLifecycle" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "reusableLifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["invocationId", "definitionDigest", "hook"],
      "properties": {
        "invocationId": { "$ref": "#/$defs/id" },
        "definitionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "hook": { "enum": ["on-success", "on-error", "on-complete"] },
        "actionId": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["succeeded", "failed", "completed_with_warnings"] },
        "warningCode": { "type": "string", "pattern": "^WOML_[A-Z0-9_]+$" }
      }
    }
  }
}
