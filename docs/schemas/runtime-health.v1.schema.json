{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/runtime-health/v1",
  "title": "WOML Runtime Health v1",
  "x-status": "production-runtime-pro0-frozen",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["profile", "kind", "status"],
      "properties": { "profile": { "const": "woml.runtime-health/v1" }, "kind": { "enum": ["liveness", "readiness"] }, "status": { "enum": ["ok", "unready"] } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["profile", "kind", "status", "runtimeInstanceId", "components"],
      "properties": {
        "profile": { "const": "woml.runtime-health/v1" }, "kind": { "const": "detail" }, "status": { "enum": ["ready", "degraded", "unready"] },
        "runtimeInstanceId": { "type": "string", "minLength": 1, "maxLength": 320 },
        "components": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 320 }, "status": { "enum": ["ready", "degraded", "unready", "stopped"] }, "code": { "type": "string", "pattern": "^WOML_[A-Z0-9_]+$" } } } }
      }
    }
  ]
}
