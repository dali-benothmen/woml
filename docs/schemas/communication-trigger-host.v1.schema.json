{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/communication-trigger-host/v1",
  "title": "WOML Communication Trigger Host Protocol v1",
  "description": "Asynchronous provider-neutral boundary between Bun communication adapters and durable Rust Trigger Ingress v1.",
  "x-status": "additional-communication-providers-acp0-frozen",
  "x-correlation": "receiptId correlates occurrence with admission-result; several occurrences may be in flight and results may complete out of order.",
  "x-acknowledgement": "A provider acknowledgement or cursor advance occurs only after an accepted or duplicate durable admission-result.",
  "oneOf": [
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/connection" },
    { "$ref": "#/$defs/occurrence" },
    { "$ref": "#/$defs/admissionResult" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "provider": { "enum": ["slack", "telegram", "discord", "whatsapp"] },
    "id": { "type": "string", "minLength": 1, "maxLength": 320 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "base": {
      "type": "object",
      "properties": {
        "protocol": { "const": "woml.communication-trigger-host" },
        "protocolVersion": { "const": 1 }
      }
    },
    "ready": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "protocolVersion", "messageType", "hostInstanceId", "providers"],
      "properties": {
        "protocol": { "const": "woml.communication-trigger-host" }, "protocolVersion": { "const": 1 },
        "messageType": { "const": "ready" }, "hostInstanceId": { "$ref": "#/$defs/id" },
        "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/provider" } }
      }
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "protocolVersion", "messageType", "provider", "accountId", "state", "occurredAt"],
      "properties": {
        "protocol": { "const": "woml.communication-trigger-host" }, "protocolVersion": { "const": 1 },
        "messageType": { "const": "connection" }, "provider": { "$ref": "#/$defs/provider" },
        "accountId": { "$ref": "#/$defs/id" }, "state": { "enum": ["connecting", "ready", "reconnecting", "stopped"] },
        "retryAt": { "type": "string", "format": "date-time" }, "occurredAt": { "type": "string", "format": "date-time" }
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "protocolVersion", "messageType", "receiptId", "provider", "accountId", "externalEventId", "workflowId", "definitionHash", "triggerId", "triggerHandler", "payload", "receivedAt"],
      "properties": {
        "protocol": { "const": "woml.communication-trigger-host" }, "protocolVersion": { "const": 1 },
        "messageType": { "const": "occurrence" }, "receiptId": { "$ref": "#/$defs/id" },
        "provider": { "$ref": "#/$defs/provider" }, "accountId": { "$ref": "#/$defs/id" },
        "externalEventId": { "$ref": "#/$defs/id" }, "workflowId": { "$ref": "#/$defs/id" },
        "definitionHash": { "$ref": "#/$defs/sha256" }, "triggerId": { "$ref": "#/$defs/id" },
        "triggerHandler": { "enum": ["trigger.slack", "trigger.telegram", "trigger.discord", "trigger.whatsapp"] },
        "payload": { "$ref": "https://woml.dev/schemas/communication-trigger-payload/v1" },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "admissionResult": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "protocolVersion", "messageType", "receiptId", "outcome", "runId", "duplicate"],
          "properties": {
            "protocol": { "const": "woml.communication-trigger-host" }, "protocolVersion": { "const": 1 }, "messageType": { "const": "admission-result" },
            "receiptId": { "$ref": "#/$defs/id" }, "outcome": { "const": "accepted" }, "runId": { "$ref": "#/$defs/id" }, "duplicate": { "type": "boolean" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "protocolVersion", "messageType", "receiptId", "outcome", "error"],
          "properties": {
            "protocol": { "const": "woml.communication-trigger-host" }, "protocolVersion": { "const": 1 }, "messageType": { "const": "admission-result" },
            "receiptId": { "$ref": "#/$defs/id" }, "outcome": { "const": "rejected" }, "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "protocolVersion", "messageType", "provider", "code", "message", "retryable"],
      "properties": {
        "protocol": { "const": "woml.communication-trigger-host" }, "protocolVersion": { "const": 1 }, "messageType": { "const": "failure" },
        "provider": { "$ref": "#/$defs/provider" }, "receiptId": { "$ref": "#/$defs/id" }, "error": { "$ref": "#/$defs/error" },
        "code": { "type": "string", "pattern": "^WOML_[A-Z0-9_]+$", "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 }, "retryable": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^WOML_[A-Z0-9_]+$", "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 }, "retryable": { "type": "boolean" }
      }
    }
  }
}
