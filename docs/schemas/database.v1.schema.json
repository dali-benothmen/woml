{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cronflow.dev/schemas/database/v1",
  "title": "WOML Database v1",
  "description": "SQLite/PostgreSQL-portable request and result contract for services.db. SC7 executes SQLite; SC8 adds PostgreSQL.",
  "x-status": "database-contract-frozen-sc7",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 128
    },
    "parameter": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 1048576 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytesBase64"],
          "properties": {
            "bytesBase64": { "type": "string", "contentEncoding": "base64", "maxLength": 1398104 }
          }
        }
      ]
    },
    "parameters": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "valueMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "queryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 262144 },
        "values": { "$ref": "#/$defs/parameters" }
      }
    },
    "executeInput": {
      "$ref": "#/$defs/queryInput"
    },
    "readInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "table": { "$ref": "#/$defs/identifier" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "where": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "orderBy": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column"],
            "properties": {
              "column": { "$ref": "#/$defs/identifier" },
              "direction": { "enum": ["asc", "desc"] }
            }
          }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "insertInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "values"],
      "properties": {
        "table": { "$ref": "#/$defs/identifier" },
        "values": { "$ref": "#/$defs/valueMap" }
      }
    },
    "updateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "values", "where"],
      "properties": {
        "table": { "$ref": "#/$defs/identifier" },
        "values": { "$ref": "#/$defs/valueMap" },
        "where": { "$ref": "#/$defs/valueMap" }
      }
    },
    "deleteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "where"],
      "properties": {
        "table": { "$ref": "#/$defs/identifier" },
        "where": { "$ref": "#/$defs/valueMap" }
      }
    },
    "transactionOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "text"],
          "properties": {
            "operation": { "const": "query" },
            "text": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "values": { "$ref": "#/$defs/parameters" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "text"],
          "properties": {
            "operation": { "const": "execute" },
            "text": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "values": { "$ref": "#/$defs/parameters" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "table", "values"],
          "properties": {
            "operation": { "const": "insert" },
            "table": { "$ref": "#/$defs/identifier" },
            "values": { "$ref": "#/$defs/valueMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "table", "values", "where"],
          "properties": {
            "operation": { "const": "update" },
            "table": { "$ref": "#/$defs/identifier" },
            "values": { "$ref": "#/$defs/valueMap" },
            "where": { "$ref": "#/$defs/valueMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "table", "where"],
          "properties": {
            "operation": { "const": "delete" },
            "table": { "$ref": "#/$defs/identifier" },
            "where": { "$ref": "#/$defs/valueMap" }
          }
        }
      ]
    },
    "transactionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/transactionOperation" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contractVersion", "kind", "driver", "connection", "operation", "input"],
      "properties": {
        "contract": { "const": "woml.database" },
        "contractVersion": { "const": 1 },
        "kind": { "const": "request" },
        "driver": { "enum": ["sqlite"] },
        "connection": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "operation": { "enum": ["query", "execute", "read", "insert", "update", "delete", "transaction"] },
        "input": {}
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "query" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/queryInput" } } } },
        { "if": { "properties": { "operation": { "const": "execute" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/executeInput" } } } },
        { "if": { "properties": { "operation": { "const": "read" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/readInput" } } } },
        { "if": { "properties": { "operation": { "const": "insert" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/insertInput" } } } },
        { "if": { "properties": { "operation": { "const": "update" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/updateInput" } } } },
        { "if": { "properties": { "operation": { "const": "delete" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/deleteInput" } } } },
        { "if": { "properties": { "operation": { "const": "transaction" } } }, "then": { "properties": { "input": { "$ref": "#/$defs/transactionInput" } } } }
      ]
    },
    "row": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          { "type": "number" },
          { "type": "string" },
          { "type": "object", "additionalProperties": false, "required": ["bytesBase64"], "properties": { "bytesBase64": { "type": "string", "contentEncoding": "base64" } } }
        ]
      }
    },
    "queryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "rowCount"],
      "properties": {
        "rows": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/row" } },
        "rowCount": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "mutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowsAffected", "lastInsertId"],
      "properties": {
        "rowsAffected": { "type": "integer", "minimum": 0 },
        "lastInsertId": { "type": ["integer", "null"] }
      }
    },
    "transactionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "oneOf": [{ "$ref": "#/$defs/queryResult" }, { "$ref": "#/$defs/mutationResult" }] }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contractVersion", "kind", "operation", "data"],
      "properties": {
        "contract": { "const": "woml.database" },
        "contractVersion": { "const": 1 },
        "kind": { "const": "result" },
        "operation": { "enum": ["query", "execute", "read", "insert", "update", "delete", "transaction"] },
        "data": {}
      },
      "allOf": [
        { "if": { "properties": { "operation": { "enum": ["query", "read"] } } }, "then": { "properties": { "data": { "$ref": "#/$defs/queryResult" } } } },
        { "if": { "properties": { "operation": { "enum": ["execute", "insert", "update", "delete"] } } }, "then": { "properties": { "data": { "$ref": "#/$defs/mutationResult" } } } },
        { "if": { "properties": { "operation": { "const": "transaction" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/transactionResult" } } } }
      ]
    }
  }
}
