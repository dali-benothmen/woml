<workflow
  woml-version="0.1"
  id="hello"
  name="Hello WOML">

  <triggers>
    <manual id="start" />
  </triggers>

  <steps>
    <step
      id="a"
      name="Choose greeting name"
      description="Use the trigger name or default to Dali">
      <script>
        const name = context.trigger.name ?? "Dali";
        const age = 10 + 10 + 10

        return {
          x: name,
          age
        };
      </script>
    </step>

    <step id="b">
      <script>
        return {
          message: `Hello my name is ${context.steps.a.x} and i'm ${context.steps.a.age} years old`,
        };
      </script>
    </step>
  </steps>
</workflow>
