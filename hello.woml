<workflow
  version="0.1"
  id="hello"
  name="Hello WOML">

  <triggers>
    <manual id="start" />
  </triggers>

  <steps>
    <step
      id="a"
      name="Choose greeting name"
      description="Use the trigger name or default to World">
      <script>
        const name = context.trigger.name ?? "Mohamed Ali";
        const age = 10 + 20

        return {
          name,
          age
        };
      </script>
    </step>

    <step id="b">
      <script>
        const {name, age} = context.steps.a

        return {
          message: `Hello i'm ${name} and i'm ${age} years old`
        };
      </script>
    </step>
  </steps>
</workflow>
