{
  "display_information": {
    "name": "WOML Approvals",
    "description": "Approve or reject WOML workflow runs from Slack.",
    "background_color": "#4f46e5"
  },
  "features": {
    "bot_user": {
      "display_name": "WOML",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
