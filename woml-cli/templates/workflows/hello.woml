<woml>
  <workflow id="hello" name="Hello WOML">
    <triggers>
      <manual id="start" />
    </triggers>
    <steps>
      <step id="greet" name="Build greeting">
        <script>
          return { message: "Hello from WOML" };
        </script>
      </step>
    </steps>
  </workflow>
</woml>

