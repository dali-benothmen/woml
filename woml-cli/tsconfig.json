{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/build-javascript.ts",
    "scripts/guard-source-publish.ts",
    "scripts/release-artifact.ts",
    "scripts/release-check.ts",
    "scripts/release-contract.ts",
    "scripts/release-package.ts",
    "scripts/run-cli-test-shards.ts"
  ]
}
