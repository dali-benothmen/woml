  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/build-javascript.ts",
    "scripts/guard-source-publish.ts",
    "scripts/release-artifact.ts",
    "scripts/release-check.ts",
    "scripts/release-contract.ts",
    "scripts/release-package.ts",
    "scripts/run-cli-test-shards.ts",
    "scripts/measure-workflow.ts",
    "scripts/performance-measurement.ts",
    "scripts/combined-activation-measurement.ts",
    "scripts/combined-output-measurement.ts",
    "scripts/incremental-scheduling-measurement.ts",
    "scripts/invocation-setup-measurement.ts",
    "scripts/invocation-setup-analysis.ts",
    "scripts/invocation-setup-fixtures.ts",
    "scripts/invocation-setup-child.ts",
    "scripts/invocation-setup-probe.ts",
    "scripts/invocation-setup-probe-worker.ts",
    "scripts/investigate-incremental-scheduling-controls.ts",
    "scripts/benchmark-combined-developer-experience.ts",
    "scripts/performance-regression.ts",
    "scripts/performance-runtime-child.ts",
    "scripts/runtime-profile-child.ts",
    "scripts/runtime-profile-fixtures.ts",
    "scripts/profile-runtime-investigation.ts",
    "scripts/runtime-session-profile-child.ts",
    "scripts/verify-startup-separation-native.ts",
    "scripts/startup-separation-baseline.ts",
    "scripts/startup-separation-comparison.ts",
    "scripts/build-startup-separation-candidate.ts",
    "scripts/profile-runtime-sessions.ts",
    "scripts/run-performance-regression.ts"
  ]
}
