{
  "name": "woml-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "woml": "./dist/cli.js"
  },
  "files": [
    "dist",
    "slack"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun run build:native && bun run build:js",
    "build:native": "cargo build --manifest-path ../core/Cargo.toml --lib --release && bun scripts/stage-native.ts",
    "build:js": "bun build src/cli.ts --outfile dist/cli.js --target bun && bun build src/script-host.ts --outfile dist/script-host.js --target bun && bun build src/script-host-worker.ts --outfile dist/script-host-worker.js --target bun && bun build src/notification-provider-host.ts --outfile dist/notification-provider-host.js --target bun",
    "test": "bun test",
    "test:n6": "bun scripts/verify-n6.ts",
    "test:ri7": "bun scripts/verify-ri7.ts",
    "test:t5": "bun scripts/verify-t5.ts",
    "test:t6": "bun scripts/verify-t6.ts",
    "test:t7": "bun scripts/verify-t7.ts",
    "test:t8": "bun scripts/verify-t8.ts",
    "test:t9": "bun scripts/verify-t9.ts",
    "test:t10": "bun scripts/verify-t10.ts",
    "test:t11": "bun scripts/verify-t11.ts",
    "test:t12": "bun scripts/verify-t12.ts",
    "test:release": "bun scripts/verify-t12.ts",
    "test:r3": "bun test tests/rust-executor.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "woml": "file:../woml"
  }
}
