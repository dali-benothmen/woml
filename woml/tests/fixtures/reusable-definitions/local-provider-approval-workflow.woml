<woml>
  <imports>
    <module name="local-approval" from="./local-approval-provider.woml" />
  </imports>
  <workflow id="local-provider-approval" name="Local provider acceptance">
    <lifecycle>
      <on-success>
        <notify>
          <local-approval
            label="completed"
            relay-url="http://127.0.0.1:7360/notify"
            message="Workflow completed"
          />
        </notify>
      </on-success>
    </lifecycle>
    <triggers>
      <manual id="start" />
    </triggers>
    <steps>
      <step id="prepare">
        <script>return { orderId: "order-42" };</script>
      </step>
      <approval id="review" name="Review local provider">
        <notify>
          <local-approval
            label="review"
            relay-url="http://127.0.0.1:7360/notify"
            message="Review {{context.steps.prepare.orderId}}"
          />
        </notify>
        <when-approved>
          <step id="approved">
            <script>return { approved: true };</script>
          </step>
        </when-approved>
        <when-rejected>
          <step id="rejected">
            <script>return { approved: false };</script>
          </step>
        </when-rejected>
      </approval>
      <step id="finish">
        <script>
          return {
            orderId: context.steps.prepare.orderId,
            approved: context.steps.review.decision === "approved"
          };
        </script>
      </step>
    </steps>
  </workflow>
</woml>
