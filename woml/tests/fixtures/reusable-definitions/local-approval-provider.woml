<woml>
  <props>
    <prop name="label" required="true" />
    <prop name="relay-url" required="true" />
  </props>
  <provider kind="notification">
    <script>
      if (notification.kind === "approval") {
        await services.http.request({
          url: props.relayUrl,
          method: "POST",
          json: {
            approve: notification.actions.approve.url,
            reject: notification.actions.reject.url
          }
        });
      }
      return { messageId: `${props.label}:${notification.deliveryId}` };
    </script>
  </provider>
</woml>
