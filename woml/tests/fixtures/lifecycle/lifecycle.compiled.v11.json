            "actionId": "lifecycle:run_complete:action:0",
            "handler": "runtime.lifecycle-script",
            "inputs": {
              "kind": "object",
              "fields": {
                "source": {
                  "kind": "literal",
                  "value": "\n          console.log(`Final outcome: ${lifecycle.workflow.outcome}`);\n        "
                }
              }
            },
            "scriptRuntime": {
              "bindingVersion": 2,
              "bindings": [
                "context",
