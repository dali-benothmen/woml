              ],
              "requiredSecrets": []
            }
          }
        ]
      },
      {
        "hookId": "lifecycle:run_cancel",
        "event": "run_cancel",
        "actions": [
          {
            "actionId": "lifecycle:run_cancel:action:0",
            "handler": "runtime.lifecycle-script",
            "inputs": {
              "kind": "object",
              "fields": {
                "source": {
                  "kind": "literal",
                  "value": "\n          console.log('Workflow cancelled');\n        "
                }
