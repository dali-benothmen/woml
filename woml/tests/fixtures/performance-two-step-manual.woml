<woml>
  <workflow
    id="performance-two-step"
    name="Performance two-step baseline"
    description="Measures fixed WOML runtime costs with two tiny sequential scripts."
    version="1.0.0"
  >
    <triggers>
      <manual id="start" />
    </triggers>

    <steps>
      <step id="prepare" name="Prepare greeting">
        <script>
          return { name: context.payload.name ?? "World" };
        </script>
      </step>

      <step id="result" name="Build result">
        <script>
          return { message: `Hello ${context.steps.prepare.name}` };
        </script>
      </step>
    </steps>
  </workflow>
</woml>

