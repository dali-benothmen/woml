<woml>
  <imports>
    <module name="spreadsheet" from="./spreadsheet.ts" />
  </imports>

  <workflow id="customer-import" name="Customer import" version="1.0.0">
    <triggers>
      <manual id="start" />
    </triggers>

    <steps>
      <step id="cleanRows">
        <script>
          const rows = context.trigger.rows ?? [];
          return {
            rows: await services.spreadsheet.removeEmptyRows(rows)
          };
        </script>
      </step>
    </steps>
  </workflow>
</woml>
