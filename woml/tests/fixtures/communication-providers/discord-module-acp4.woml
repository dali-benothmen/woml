<woml>
  <imports>
    <module name="discordHelper" from="./discord-helper.ts" />
  </imports>
  <workflow id="discord-module" name="Discord module discovery" version="1.0.0">
    <triggers>
      <manual id="start" />
    </triggers>
    <steps>
      <step id="send">
        <script>
          return services.discordHelper.sendReply(
            secrets.DISCORD_BOT_TOKEN,
            context.payload.conversationId,
            'Hello from a local module'
          );
        </script>
      </step>
    </steps>
  </workflow>
</woml>
