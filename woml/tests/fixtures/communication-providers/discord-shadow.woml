<woml>
  <imports>
    <module name="discord" from="./discord-shadow.ts" />
  </imports>
  <workflow id="discord-shadow" name="Discord alias compatibility" version="1.0.0">
    <triggers>
      <manual id="start" />
    </triggers>
    <steps>
      <step id="send">
        <script>
          return services.discord.send('local behavior');
        </script>
      </step>
    </steps>
  </workflow>
</woml>
