<woml>
<workflow id="invalid-nested-fork" version="1.0.0">
  <triggers><manual id="start" /></triggers>
  <steps>
    <step id="ready"><script>return true;</script></step>
    <fork id="outerFork" join="all">
      <branch id="outerBranch">
        <choose id="route">
          <when test="{{context.steps.ready}}">
            <fork id="forbiddenNestedFork" join="all">
              <branch id="nestedBranch"><step id="nestedStep"><script>return true;</script></step></branch>
            </fork>
            <result value="{{context.steps.nestedStep}}" />
          </when>
          <otherwise><step id="fallback"><script>return false;</script></step><result value="{{context.steps.fallback}}" /></otherwise>
        </choose>
      </branch>
    </fork>
    <step id="finish"><script>return true;</script></step>
  </steps>
</workflow>
</woml>
