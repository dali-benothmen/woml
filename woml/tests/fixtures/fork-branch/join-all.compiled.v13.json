      { "id": "__woml_fork__distribution__instagram__terminal", "handler": "engine.fork-branch-terminal", "inputs": { "kind": "object", "fields": {} } },
      { "id": "publishFacebook", "handler": "runtime.script", "inputs": { "kind": "object", "fields": { "source": { "kind": "literal", "value": "return { platform: \"facebook\" };" } } }, "scriptRuntime": { "bindingVersion": 1, "bindings": ["context", "attempt", "services", "secrets"], "requiredSecrets": [] } },
      { "id": "__woml_fork__distribution__facebook__terminal", "handler": "engine.fork-branch-terminal", "inputs": { "kind": "object", "fields": {} } },
      { "id": "__woml_fork__distribution__join", "handler": "engine.fork-join", "inputs": { "kind": "object", "fields": {} } },
