      { "id": "distribution:branch:facebook", "from": "__woml_fork__distribution__open", "to": "publishFacebook", "condition": { "kind": "always" } },
      { "id": "distribution:terminal:instagram", "from": "publishInstagram", "to": "__woml_fork__distribution__instagram__terminal", "condition": { "kind": "always" } },
      { "id": "distribution:terminal:facebook", "from": "publishFacebook", "to": "__woml_fork__distribution__facebook__terminal", "condition": { "kind": "always" } },
      { "id": "distribution:join:instagram", "from": "__woml_fork__distribution__instagram__terminal", "to": "__woml_fork__distribution__join", "condition": { "kind": "always" } },
      { "id": "distribution:join:facebook", "from": "__woml_fork__distribution__facebook__terminal", "to": "__woml_fork__distribution__join", "condition": { "kind": "always" } },
      { "id": "__woml_fork__distribution__join-to-finish", "from": "__woml_fork__distribution__join", "to": "finish", "condition": { "kind": "always" } },
      { "id": "__woml_workflow__:main:settlement", "from": "finish", "to": "__woml_workflow__settlement", "condition": { "kind": "always" } },
      { "id": "__woml_fork__distribution__instagram__terminal:settlement", "from": "__woml_fork__distribution__instagram__terminal", "to": "__woml_workflow__settlement", "condition": { "kind": "always" } },
      { "id": "__woml_fork__distribution__facebook__terminal:settlement", "from": "__woml_fork__distribution__facebook__terminal", "to": "__woml_workflow__settlement", "condition": { "kind": "always" } }
