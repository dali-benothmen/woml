          { "branchId": "facebook", "entryNodeId": "publishFacebook", "terminalNodeId": "__woml_fork__distribution__facebook__terminal" }
        ],
        "joinedBranchIds": ["instagram", "facebook"]
      }
    ],
    "choices": [],
    "contextVisibility": [
      { "nodeId": "prepare", "stepIds": [] },
      { "nodeId": "publishInstagram", "stepIds": ["prepare"] },
      { "nodeId": "publishFacebook", "stepIds": ["prepare"] },
      { "nodeId": "finish", "stepIds": ["prepare", "publishInstagram", "publishFacebook"] }
    ],
    "settlement": {
