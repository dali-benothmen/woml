<woml>
  <imports>
    <module name="release" from="./release.ts" />
  </imports>
  <workflow id="remote-module">
    <triggers>
      <manual id="start" />
    </triggers>
    <steps>
      <step id="deploy" target="production-private">
        <script>
          return await services.release.describe("payments-api@42");
        </script>
      </step>
    </steps>
  </workflow>
</woml>
