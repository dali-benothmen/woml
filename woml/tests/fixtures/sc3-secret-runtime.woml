<woml>
<workflow id="sc3-secret-runtime" version="1.0.0" name="SC3 secret runtime">
  <triggers>
    <manual id="start" />
  </triggers>
  <steps>
    <step id="inspectSecretBinding">
      <script>
        return {
          secretLength: secrets.SC3_TEST_TOKEN.length
        };
      </script>
    </step>
  </steps>
</workflow>
</woml>
