<workflow
  version="0.1"
  id="retry-composition"
  name="Nested Retry Composition">

  <triggers>
    <manual id="start" />
  </triggers>

  <steps>
    <step id="chooseRoute">
      <script>
        return { useParallelChecks: true };
      </script>
    </step>

    <branch id="route">
      <when test="{{context.steps.chooseRoute.useParallelChecks}}">
        <parallel id="checks" concurrency="2" on-error="wait-all">
          <step
            id="leftCheck"
            retry="2"
            retry-backoff="fixed"
            retry-delay="1ms">
            <script>
              if (attempt.number === 1) {
                throw new Error("Left check is temporarily unavailable");
              }
              return { value: 20 };
            </script>
          </step>

          <step
            id="rightCheck"
            retry="3"
            retry-backoff="fixed"
            retry-delay="1ms">
            <script>
              if (attempt.number !== 3) {
                throw new Error("Right check is temporarily unavailable");
              }
              return { value: 22 };
            </script>
          </step>
        </parallel>
        <result value="{{context.steps.leftCheck}}" />
      </when>

      <otherwise>
        <step id="fallback">
          <script>
            return { value: 0 };
          </script>
        </step>
        <result value="{{context.steps.fallback}}" />
      </otherwise>
    </branch>

    <step id="finish">
      <script>
        return {
          total: context.steps.route.value + context.steps.rightCheck.value
        };
      </script>
    </step>
  </steps>
</workflow>
