{
  "name": "woml-repository",
  "version": "1.0.10",
  "private": true,
  "description": "WOML workflow automation monorepo",
  "author": "Mohamed Ali Ben Othmen",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dali-benothmen/woml.git"
  },
  "scripts": {
    "install:check": "bun install --cwd woml --frozen-lockfile && bun install --cwd woml-cli --frozen-lockfile",
    "build": "bun run --cwd woml-cli build",
    "build:release": "bun run --cwd woml-cli build:release",
    "test": "bun run --cwd woml-cli test:portable",
    "typecheck": "bun run --cwd woml-cli typecheck",
    "format:check": "cargo fmt --all --manifest-path core/Cargo.toml -- --check",
    "lint": "bun run --cwd woml-cli test:communication-provider-clippy",
    "pack": "bun run --cwd woml-cli pack:release",
    "test:identity": "bun run --cwd woml-cli test:release-identity",
    "test:release-automation": "bun run --cwd woml-cli test:release-automation",
    "test:documentation": "bun run --cwd woml-cli test:documentation",
    "test:architecture": "bun run --cwd woml-cli test:architecture-separation",
    "test:final-review": "bun run --cwd woml-cli test:final-review",
    "measure:workflow": "bun run --cwd woml-cli measure:workflow",
    "measure:workflow:manual": "bun run --cwd woml-cli measure:workflow:manual",
    "measure:workflow:engine": "bun run --cwd woml-cli measure:workflow:engine",
    "profile:workflow:frontend": "bun run --cwd woml-cli profile:workflow:frontend",
    "profile:workflow:frontend:source": "bun run --cwd woml-cli profile:workflow:frontend:source",
    "profile:workflow:runtime": "bun run --cwd woml-cli profile:workflow:runtime",
    "profile:workflow:steps": "bun run --cwd woml-cli profile:workflow:steps",
    "profile:workflow:context": "bun run --cwd woml-cli profile:workflow:context",
    "profile:workflow:presentation": "bun run --cwd woml-cli profile:workflow:presentation",
    "profile:presentation:modes": "bun run --cwd woml-cli profile:presentation:modes",
    "benchmark:performance-baseline": "bun run --cwd woml-cli benchmark:performance-baseline",
    "benchmark:performance-baseline:quick": "bun run --cwd woml-cli benchmark:performance-baseline:quick",
    "test:performance-regression": "bun run --cwd woml-cli test:performance-regression",
    "report:performance-regression": "bun run --cwd woml-cli report:performance-regression",
    "release:check": "bun woml-cli/scripts/release-check.ts",
    "test:release": "bun run release:check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,toml}": [
      "prettier --write"
    ],
    "*.rs": [
      "cargo fmt --manifest-path core/Cargo.toml --"
    ]
  }
}
