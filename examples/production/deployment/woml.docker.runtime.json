{
  "schemaVersion": 1,
  "deploymentName": "woml-complete-production",
  "statePath": "/app/data/state.sqlite",
  "public": { "host": "0.0.0.0", "port": 3000 },
  "admin": { "host": "127.0.0.1", "port": 3001 },
  "logging": {
    "format": "json",
    "level": "info",
    "directory": "/app/logs"
  },
  "workers": 8,
  "shutdownTimeoutMs": 30000,
  "observability": { "health": true, "metrics": true },
  "retention": {
    "enabled": true,
    "succeededAfterDays": 30,
    "failedAfterDays": 90,
    "cancelledAfterDays": 30,
    "maintenanceHourUtc": 3
  },
  "backup": { "directory": "/app/backups" }
}
