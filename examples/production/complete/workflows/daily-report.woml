<woml>
  <workflow id="production-daily-report" name="Daily operations report" version="1.0.0">
    <triggers>
      <schedule id="dailyReport" cron="0 9 * * *" timezone="Europe/Berlin" on-missed="run-once" />
    </triggers>
    <steps>
      <step id="read"><script>
        const completed = await services.state.get('completed-runs');
        return { completedRuns: completed.found ? completed.value : 0 };
      </script></step>
    </steps>
  </workflow>
</woml>
