<woml>
<workflow id="slack-trigger-contract" name="Slack Agent Message" version="1.0.0">
  <triggers>
    <slack
      id="agentMessage"
      events="app-mention,direct-message"
      channels="woml-testing"
      bot-token="{{secrets.SLACK_BOT_TOKEN}}"
      app-token="{{secrets.SLACK_APP_TOKEN}}"
    />
  </triggers>
  <steps>
    <step id="capture">
      <script>
        return context.payload;
      </script>
    </step>
  </steps>
</workflow>
</woml>
