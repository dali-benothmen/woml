<woml>
  <workflow
    id="discord-approval-demo"
    name="Discord Approval"
    description="Requests one durable approval through Discord buttons."
    version="1.0.0"
  >
    <triggers>
      <manual id="start" />
    </triggers>

    <steps>
      <approval
        id="review"
        name="Approve the WOML test run"
        timeout="24h"
        on-timeout="reject"
      >
        <notify>
          <discord
            channels="200000000000000001"
            bot-token="{{secrets.DISCORD_BOT_TOKEN}}"
          />
        </notify>

        <when-approved>
          <step id="approved" name="Approval accepted">
            <script>return { decision: 'approved' };</script>
          </step>
        </when-approved>

        <when-rejected>
          <step id="rejected" name="Approval rejected">
            <script>return { decision: 'rejected' };</script>
          </step>
        </when-rejected>
      </approval>
    </steps>
  </workflow>
</woml>
